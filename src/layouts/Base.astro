---
import '../styles/interactive.css';
const { title = 'Jensen Coverage Watch', description = 'An evidence-first index of media coverage involving Jensen Huang and NVIDIA.' } = Astro.props;
const nav = [ ['/', 'Overview'], ['/timeline','Coverage timeline'], ['/articles','Article explorer'], ['/coverage','Collection coverage'], ['/journalists','Journalists'], ['/media','Media comparison'], ['/funding','Funding transparency'], ['/narratives','Narrative analysis'], ['/reports','Research reports'], ['/methodology','Methodology'], ['/corrections','Corrections'] ];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#0b1018"/><title>{title} · Jensen Coverage Watch</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><div class="site-shell"><aside class="sidebar"><a class="brand" href="/" aria-label="Jensen Coverage Watch home"><span class="brand-mark">J<span>·</span>C</span><span class="brand-name">JENSEN<br/>COVERAGE WATCH</span></a><div class="side-label">INVESTIGATE</div><nav aria-label="Primary navigation">{nav.map(([href,label]) => <a href={href} class:list={{ active: Astro.url.pathname === href || (href !== '/' && Astro.url.pathname.startsWith(href+'/')) }}>{label}</a>)}</nav><div class="sidebar-bottom"><span class="live-dot"></span> RESEARCH FILE / 2026<div class="side-note">Who wrote what. When.<br/>And who funded it.</div></div></aside><div class="content"><header class="topbar"><div class="mobile-brand"><a href="/">J·C <span>JENSEN COVERAGE WATCH</span></a></div><span class="top-eyebrow">INDEPENDENT MEDIA TRANSPARENCY PROJECT</span><a class="top-method" href="/methodology">How we verify <span>↗</span></a></header><main><slot/></main><footer><div><strong>JENSEN COVERAGE WATCH</strong><p>An evidence-first record of coverage. An article’s existence does not establish the truth of its claims.</p></div><div><a href="/methodology">Methodology</a><a href="/corrections">Corrections & challenges</a><a href="/admin">Research admin</a></div><small>RESEARCH SNAPSHOT · 21 NOV 2026</small></footer></div></div></body></html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#e9edf3;background:#0b1018;font-size:16px;font-synthesis:none}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select{outline-offset:3px}button{cursor:pointer}h1,h2,h3,p{margin-top:0}.site-shell{min-height:100vh;display:grid;grid-template-columns:244px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;border-right:1px solid #27313d;background:#0b1018;padding:28px 18px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:13px;padding:5px 12px 35px}.brand-mark{font-family:'Playfair Display',serif;font-weight:700;color:#fff;font-size:30px;letter-spacing:-3px}.brand-mark span{color:#e65756}.brand-name{font-size:10px;line-height:1.25;letter-spacing:.15em;font-weight:700}.side-label,.eyebrow,.kicker,.meta,.micro,.sidebar-bottom,.top-eyebrow,.top-method,footer small{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.11em}.side-label{padding:0 15px 11px;color:#768493}.sidebar nav{display:grid;gap:4px}.sidebar nav a{padding:11px 14px;color:#9aa7b5;font-size:13px;border-radius:5px;transition:background .2s,color .2s}.sidebar nav a:hover,.sidebar nav a.active{background:#1b2733;color:#f8fafc}.sidebar nav a.active{border-left:2px solid #ef625e}.sidebar-bottom{margin-top:auto;padding:20px 14px 0;border-top:1px solid #27313d;color:#a5b4c1}.live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#e85f5c;margin-right:7px}.side-note{font-family:'Playfair Display',serif;font-size:15px;line-height:1.5;letter-spacing:0;color:#d9e0e8;margin-top:15px}.content{min-width:0}.topbar{height:65px;border-bottom:1px solid #27313d;display:flex;align-items:center;justify-content:space-between;padding:0 4.2%;background:#0b1018}.top-eyebrow{color:#7c8b9d}.top-method{color:#d6dce3}.top-method span{color:#ef625e}.mobile-brand{display:none}main{max-width:1540px;margin:auto;padding:0 4.2% 80px}footer{border-top:1px solid #26323f;padding:45px 4.2%;display:flex;justify-content:space-between;gap:30px;color:#8090a1;font-size:13px}footer strong{color:#eff2f6;font-size:12px;letter-spacing:.08em}footer p{max-width:400px;line-height:1.6;margin:10px 0 0}footer>div:nth-child(2){display:grid;align-content:start;gap:10px}footer a:hover{color:#fff}.eyebrow,.kicker{color:#e96a63;font-weight:600}.page-heading{padding:60px 0 31px;border-bottom:1px solid #2a3541}.page-heading h1,.hero h1{font-family:'Playfair Display',serif;letter-spacing:-.045em;font-weight:600}.page-heading h1{font-size:clamp(37px,4.5vw,62px);line-height:1.08;margin:14px 0}.page-heading p{color:#aab6c3;max-width:700px;line-height:1.65}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:40px 0 20px}.section-head h2{font-family:'Playfair Display',serif;font-size:27px;font-weight:600;letter-spacing:-.025em;margin:0}.section-head a,.inline-link{color:#ef7a73;font-size:13px}.section-head a:hover,.inline-link:hover{text-decoration:underline}.panel{background:#111a24;border:1px solid #2b3845;border-radius:7px}.badge{display:inline-block;border:1px solid #3b4b58;border-radius:3px;color:#b7c5d1;font:11px 'IBM Plex Mono',monospace;letter-spacing:.06em;padding:5px 7px;text-transform:uppercase}.badge.critical{color:#f18a83;border-color:#82474b;background:#301f28}.badge.mixed{color:#e4bd83;border-color:#6c5a42;background:#29251f}.badge.neutral{color:#a5c3d4;border-color:#405667;background:#1b2832}.badge.supportive{color:#9bd6b8;border-color:#3a6657;background:#1a302b}.muted{color:#97a7b7}.meta{color:#8293a4}.empty{padding:50px 28px;text-align:center;color:#9eacb9}.empty strong{display:block;color:#e8edf2;font-family:'Playfair Display',serif;font-size:24px;margin-bottom:8px}.empty p{max-width:550px;margin:0 auto;line-height:1.6}.btn{display:inline-flex;align-items:center;justify-content:center;border:1px solid #495b6b;background:#172431;color:#edf2f5;border-radius:4px;padding:11px 17px;font-size:13px;font-weight:700}.btn:hover{background:#23384a}.btn.primary{background:#e0645d;border-color:#e0645d;color:#11151c}.btn.primary:hover{background:#f08078}.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}.prose{max-width:760px;color:#b7c3ce;line-height:1.75}.prose h2{font:600 27px 'Playfair Display',serif;color:#f4f6f8;margin-top:42px}.prose a{color:#f28b83;text-decoration:underline}.prose li{margin:8px 0}@media(max-width:900px){.site-shell{display:block}.sidebar{position:static;height:auto;padding:14px 20px;border-right:0;border-bottom:1px solid #27313d}.brand,.side-label,.sidebar-bottom{display:none}.sidebar nav{display:flex;overflow-x:auto;gap:4px}.sidebar nav a{white-space:nowrap;padding:9px 10px}.topbar{height:50px}.mobile-brand{display:block;font:700 18px 'Playfair Display',serif}.mobile-brand span{font:700 10px 'DM Sans',sans-serif;letter-spacing:.08em;margin-left:8px}.top-eyebrow{display:none}main{padding:0 5% 60px}.grid-2{grid-template-columns:1fr}}@media(max-width:560px){.top-method{font-size:10px}.page-heading{padding-top:38px}footer{display:block}footer>div{margin-bottom:26px}}
</style>
