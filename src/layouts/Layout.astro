---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
interface Props { title: string; description?: string; }
const { title, description = 'A public, source-linked archive of media coverage of Jensen Huang.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} — Jensen Huang Media Coverage Archive</title>
  <meta name="description" content={description} />
</head>
<body>
  <Nav />
  <main class="container">
    <slot />
  </main>
  <footer class="footer">
    <div class="container">
      Jensen Huang Media Coverage Archive · Classifications describe framing, not the truth of claims · See <a href="/methodology">Methodology</a> and <a href="/corrections">Corrections</a>.
    </div>
  </footer>
</body>
</html>
