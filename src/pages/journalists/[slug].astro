---
import Base from '../../layouts/Base.astro';import {articles,journalists,slug} from '../../lib/data';
export function getStaticPaths(){return journalists.map(name=>({params:{slug:slug(name)},props:{name}}))}
const {name}=Astro.props;const work=articles.filter(a=>a.authors.includes(name));const pubs=[...new Set(work.map(a=>a.publication))];
---
<Base title={name}><div class="page-heading"><a class="inline-link" href="/journalists">← All journalists</a><div style="height:25px"></div><span class="kicker">VERIFIED BYLINE PROFILE</span><h1>{name}</h1><p>{pubs.join(' · ')} · Affiliation on linked articles; employment dates have not been independently established.</p></div><div class="profile-stats"><div><strong>{work.length}</strong><span>AUTHORED / CO-AUTHORED</span></div><div><strong>{work.filter(a=>a.authors.length>1).length}</strong><span>CO-AUTHORED</span></div><div><strong>{[...new Set(work.map(a=>a.topic))].length}</strong><span>TOPICS IN FILE</span></div></div><div class="section-head"><h2>Verified coverage</h2></div><div class="profile-list">{work.map(a=><a class="panel" href={`/articles/${a.id}/`}><span class="meta">{a.date} / {a.publication}</span><h3>{a.headline}</h3><span class:list={['badge',a.sentiment.toLowerCase()]}>{a.sentiment}</span></a>)}</div><div class="section-head"><h2>Financial relationships</h2></div><div class="empty panel"><strong>None established in this file</strong><p>No documented funding relationship has been added for this person. This is not a claim that none exists.</p></div></Base>
<style>.profile-stats{display:flex;border-bottom:1px solid #30404e}.profile-stats>div{padding:28px 45px 28px 0;min-width:170px}.profile-stats strong{font:600 36px 'Playfair Display',serif;display:block}.profile-stats span{font:11px 'IBM Plex Mono',monospace;color:#93a5b5}.profile-list{display:grid;gap:12px}.profile-list a{padding:22px}.profile-list a:hover{border-color:#e0645d}.profile-list h3{font:600 20px 'Playfair Display',serif;margin:12px 0}.profile-stats>div:first-child{padding-left:0}@media(max-width:600px){.profile-stats{justify-content:space-between}.profile-stats>div{min-width:0;padding-right:10px}.profile-stats span{font-size:9px}}</style>
