---
import Base from '../../layouts/Base.astro';import {articles} from '../../lib/data';
export function getStaticPaths(){return articles.map(a=>({params:{id:a.id},props:{article:a}}))}
const {article:a}=Astro.props;
---
<Base title={a.headline} description={a.summary}><div class="page-heading"><a class="inline-link" href="/articles">← All articles</a><div class="detail-kicker"><span class="kicker">ARTICLE RECORD</span><span class="meta">{a.date} / {a.publication}</span></div><h1 class="detail-title">{a.headline}</h1><p>{a.authors.join(' · ')}</p></div><div class="detail-layout"><article><div class="section-head"><h2>What this piece covers</h2></div><p class="lead">{a.summary}</p><div class="section-head"><h2>Classification note</h2></div><p class="body-copy">{a.classificationReason}</p><div class="section-head"><h2>Claims and evidence</h2></div><div class="empty panel"><strong>Claim review pending</strong><p>Source metadata is verified. This record does not independently validate the publication’s claims.</p></div><div class="section-head"><h2>Corrections and history</h2></div><p class="body-copy">No publisher correction has been recorded in this tracker. This does not establish that none exists.</p></article><aside class="record-card panel"><span class="kicker">VERIFICATION CARD</span><dl><div><dt>Metadata</dt><dd>Verified</dd></div><div><dt>Claim assessment</dt><dd>Unassessed</dd></div><div><dt>Article type</dt><dd>{a.type}</dd></div><div><dt>Editorial tone</dt><dd><span class:list={['badge',a.sentiment.toLowerCase()]}>{a.sentiment}</span></dd></div><div><dt>Topic</dt><dd>{a.topic}</dd></div><div><dt>Evidence presentation</dt><dd>{a.evidence}</dd></div><div><dt>Funding disclosure</dt><dd>Not established</dd></div><div><dt>Source checked</dt><dd>{a.verifiedOn}</dd></div>{a.updated&&<div><dt>Publisher updated</dt><dd>{a.updated}</dd></div>}</dl><a class="btn primary" href={a.source} target="_blank" rel="noopener noreferrer">Read original source ↗</a></aside></div></Base>
<style>.detail-kicker{display:flex;gap:18px;align-items:center;margin-top:25px}.detail-title{max-width:990px}.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:50px;padding-top:28px}.detail-layout article{max-width:780px}.lead{font:21px/1.65 'Playfair Display',serif;color:#d9e1e9}.body-copy{color:#b3c0cc;line-height:1.7}.record-card{padding:24px;align-self:start;position:sticky;top:24px}.record-card dl{margin:25px 0}.record-card dl>div{display:flex;justify-content:space-between;gap:14px;border-bottom:1px solid #2b3946;padding:13px 0;font-size:12px}.record-card dt{color:#8fa1af}.record-card dd{text-align:right;margin:0;color:#e5edf2}.record-card .btn{width:100%}@media(max-width:800px){.detail-layout{grid-template-columns:1fr}.record-card{position:static}}</style>
