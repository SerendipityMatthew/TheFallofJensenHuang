---
import Base from '../../layouts/Base.astro';import {articles, articleEvents, events} from '../../lib/data';import {articleReport} from '../../lib/reports';
export function getStaticPaths(){return articles.map(a=>({params:{id:a.id},props:{article:a}}))}
const {article:a}=Astro.props;
const report=articleReport(a);
const linked=articleEvents.filter(link=>link.articleId===a.id).map(link=>({link,event:events.find(event=>event.id===link.eventId)})).filter(item=>item.event);
---
<Base title={a.headline} description={a.summary}>
  <div class="page-heading"><a class="inline-link" href="/articles">← All articles</a><div class="detail-kicker"><span class="kicker">ARTICLE RESEARCH DRAFT</span><span class="meta">{a.date} / {a.publication}</span></div><h1 class="detail-title">{a.headline}</h1><p>{a.authors.join(' · ')}</p></div>
  <div class="detail-layout"><article>
    <div class="section-head"><h2>Executive summary</h2></div><p class="lead">{report.executiveSummary}</p>
    <div class="section-head"><h2>Claims and evidence</h2></div>{report.claims.map(item=><div class="report-item panel"><span class="kicker">{item.status}</span><p>{item.text}</p><a href={item.source} target="_blank" rel="noopener noreferrer">Publisher account ↗</a></div>)}{report.evidence.map(item=><div class="report-item panel"><span class="kicker">{item.status}</span><p>{item.text}</p><a href={item.source} target="_blank" rel="noopener noreferrer">Inspect source ↗</a></div>)}
    <div class="section-head"><h2>Response and context</h2></div><p class="body-copy">{report.context}</p>{report.responses.map(item=><p class="body-copy">{item.text} <a href={item.source} target="_blank" rel="noopener noreferrer">Source ↗</a></p>)}
    <div class="section-head"><h2>Related events and developments</h2></div>{linked.length?linked.map(({link,event})=><p class="body-copy"><a href={`/events/${event!.id}/`}>{event!.title} ↗</a> · {link.type}</p>):<p class="body-copy">No event relationship has been verified.</p>}{report.developments.map(item=><p class="body-copy"><a href={`/articles/${item.id}/`}>{item.headline} ↗</a> · {item.date}</p>)}
    <div class="section-head"><h2>Classification and correction history</h2></div><p class="body-copy">{a.classificationReason}</p><div id="live-history" data-article-id={a.id}><p class="body-copy">No publisher correction has been recorded in this tracker. This does not establish that none exists. Last source check: {a.verifiedOn}.</p></div>
    <div class="section-head"><h2>Source register</h2></div>{[...new Set(report.sources)].map(url=><p class="body-copy"><a href={url} target="_blank" rel="noopener noreferrer">{url} ↗</a></p>)}
  </article><aside class="record-card panel"><span class="kicker">VERIFICATION CARD</span><dl><div><dt>Metadata</dt><dd>Verified</dd></div><div><dt>Claim assessment</dt><dd>Unassessed</dd></div><div><dt>Article type</dt><dd>{a.type}</dd></div><div><dt>Editorial tone</dt><dd><span class:list={['badge',a.sentiment.toLowerCase()]}>{a.sentiment}</span></dd></div><div><dt>Topic</dt><dd>{a.topic}</dd></div><div><dt>Secondary topics</dt><dd>{a.secondaryTopics?.join(', ')||'Not established'}</dd></div><div><dt>Evidence presentation</dt><dd>{a.evidence}</dd></div><div><dt>Original timestamp</dt><dd>{a.originalPublishedAt||'Date only'}</dd></div><div><dt>Original time zone</dt><dd>{a.originalTimezone||'Not established'}</dd></div><div><dt>Language / region</dt><dd>{a.language||'Not established'} / {a.region||'Not established'}</dd></div><div><dt>Funding disclosure</dt><dd>Not established</dd></div><div><dt>Source checked</dt><dd>{a.verifiedOn}</dd></div>{a.updated&&<div><dt>Publisher updated</dt><dd>{a.updated}</dd></div>}</dl><a class="btn primary" href={a.source} target="_blank" rel="noopener noreferrer">Read original source ↗</a></aside></div>
<script is:inline>const history=document.getElementById('live-history');fetch('/api/articles/'+encodeURIComponent(history.dataset.articleId)+'/history').then(r=>r.ok?r.json():null).then(data=>{if(!data?.corrections?.length)return;history.replaceChildren();for(const item of data.corrections){const p=document.createElement('p');p.className='body-copy';const a=document.createElement('a');a.href=item.source_url;a.target='_blank';a.rel='noopener noreferrer';a.textContent=`Correction · ${item.published_at} ↗`;p.append(a,document.createTextNode(' '+item.description));history.append(p)}}).catch(()=>{});</script></Base>
<style>.report-item{padding:18px 20px;margin:12px 0}.report-item p{color:#bbc9d4;line-height:1.65;margin:12px 0}.report-item a,.body-copy a{color:#ef877f;overflow-wrap:anywhere}.detail-kicker{display:flex;gap:18px;align-items:center;margin-top:25px}.detail-title{max-width:990px}.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:50px;padding-top:28px}.detail-layout article{max-width:780px}.lead{font:21px/1.65 'Playfair Display',serif;color:#d9e1e9}.body-copy{color:#b3c0cc;line-height:1.7}.record-card{padding:24px;align-self:start;position:sticky;top:24px}.record-card dl{margin:25px 0}.record-card dl>div{display:flex;justify-content:space-between;gap:14px;border-bottom:1px solid #2b3946;padding:13px 0;font-size:12px}.record-card dt{color:#8fa1af}.record-card dd{text-align:right;margin:0;color:#e5edf2}.record-card .btn{width:100%}@media(max-width:800px){.detail-layout{grid-template-columns:1fr}.record-card{position:static}}</style>
