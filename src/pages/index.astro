---
import Base from '../layouts/Base.astro';
import { articles, metrics } from '../lib/data';
import Timeline from '../components/Timeline';
const recent=articles.slice(0,3);
---
<Base title="Overview"><section class="hero"><div class="hero-copy"><span class="kicker">THE INVESTIGATIVE INDEX <span class="hero-line"></span> 01 OCT — 21 NOV 2026</span><h1>THE JENSEN HUANG<br/><em>MEDIA FILES</em></h1><p>Tracking the stories, the journalists, the narratives, and the money behind the coverage.</p><div class="hero-actions"><a class="btn primary" href="/articles">Explore the articles</a><a class="btn" href="/methodology">Read our method</a></div></div><div class="hero-aside"><span class="meta">FILE STATUS / OPEN</span><div class="vertical-rule"></div><p>Every entry starts with an original publisher page. Tone is an editorial classification. Claims require separate assessment.</p><a href="/methodology">How the file is built <span>↗</span></a></div></section><section class="metrics" aria-label="Database metrics"><div><span>01 / VERIFIED ARTICLES</span><strong data-metric="articles">{metrics.articles}</strong><small>Original sources checked</small></div><div><span>02 / JOURNALISTS</span><strong data-metric="journalists">{metrics.journalists}</strong><small>Named contributors</small></div><div><span>03 / PUBLICATIONS</span><strong data-metric="publications">{metrics.publications}</strong><small>In the current file</small></div><div><span>04 / CRITICAL ARTICLES</span><strong data-metric="critical">{metrics.critical}</strong><small>Editorial tone label</small></div></section><div class="section-head"><div><span class="kicker">THE SIGNAL</span><h2>Coverage, day by day</h2></div><a href="/timeline">Open full timeline ↗</a></div><Timeline articles={articles} client:only="react" /><div class="section-head"><div><span class="kicker">LATEST ENTRIES</span><h2>From the source file</h2></div><a href="/articles">View all articles ↗</a></div><div class="feature-grid">{recent.map(a=><a href={`/articles/${a.id}/`} class="feature-card panel"><div class="feature-top"><span class="meta">{a.publication} / {a.date}</span><span class:list={['badge',a.sentiment.toLowerCase()]}>{a.sentiment}</span></div><h3>{a.headline}</h3><p>{a.summary}</p><div class="feature-bottom">{a.authors.join(' · ')} <span>READ RECORD ↗</span></div></a>)}</div><section class="principle panel"><span class="kicker">A NOTE ON EVIDENCE</span><h2>Patterns are questions.<br/>Sources are the starting point.</h2><p>Similarity in timing or framing is an observation, not proof of coordination. A disclosed funding relationship does not by itself show editorial influence.</p><a class="inline-link" href="/methodology">Explore the verification standard ↗</a></section><script is:inline>fetch('/api/articles').then(r=>r.ok?r.json():null).then(rows=>{if(!Array.isArray(rows))return;const totals={articles:rows.length,journalists:new Set(rows.flatMap(a=>String(a.authors||'').split(' | ').filter(x=>x&&x!=='The Associated Press'))).size,publications:new Set(rows.map(a=>a.publication)).size,critical:rows.filter(a=>a.sentiment==='Critical').length};for(const [key,value] of Object.entries(totals)){const el=document.querySelector(`[data-metric="${key}"]`);if(el)el.textContent=String(value)}}).catch(()=>{});</script></Base>
<style>.hero{min-height:390px;display:flex;justify-content:space-between;gap:40px;align-items:end;padding:62px 0 56px;border-bottom:1px solid #394450;background:radial-gradient(circle at 70% 30%,#142231 0%,transparent 45%)}.hero-copy{max-width:830px}.hero .kicker{display:flex;align-items:center;gap:13px}.hero-line{display:inline-block;width:32px;height:1px;background:#e0645d}.hero h1{font-size:clamp(50px,6vw,100px);line-height:1.02;margin:26px 0 22px}.hero h1 em{font-style:normal;color:#ed7169}.hero-copy>p{font:21px/1.5 'Playfair Display',serif;color:#c4d0da;max-width:600px}.hero-actions{display:flex;gap:10px;margin-top:27px}.hero-aside{width:215px;flex:none;align-self:stretch;display:flex;flex-direction:column;align-items:start;padding:20px 0 0}.vertical-rule{height:45px;width:1px;background:#ef726b;margin:30px 0}.hero-aside p{color:#aebcc9;font-size:13px;line-height:1.7}.hero-aside a{font-size:12px;color:#f18880;margin-top:auto}.metrics{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #354350}.metrics>div{padding:27px 27px 30px 0;border-right:1px solid #273441;margin:0 0 0 25px}.metrics>div:first-child{margin-left:0}.metrics>div:last-child{border:0}.metrics span,.metrics small{display:block;color:#96a6b5;font:11px 'IBM Plex Mono',monospace;letter-spacing:.07em}.metrics strong{display:block;font:600 48px 'Playfair Display',serif;color:#fff;margin:8px 0 5px}.metrics small{letter-spacing:0}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.feature-card{padding:24px;display:flex;min-height:255px;flex-direction:column;transition:border-color .2s,transform .2s}.feature-card:hover{border-color:#e0645d;transform:translateY(-2px)}.feature-top,.feature-bottom{display:flex;justify-content:space-between;gap:12px;align-items:center}.feature-card h3{font:600 22px/1.3 'Playfair Display',serif;margin:22px 0 12px}.feature-card p{font-size:13px;color:#aab9c5;line-height:1.6}.feature-bottom{margin-top:auto;color:#8e9fad;font-size:11px}.feature-bottom span{color:#ef837b;white-space:nowrap}.principle{padding:35px 40px;margin-top:55px;background:linear-gradient(110deg,#182735,#101922)}.principle h2{font:600 35px/1.18 'Playfair Display',serif;margin:15px 0}.principle p{max-width:690px;line-height:1.65;color:#acbac7}@media(max-width:1100px){.feature-grid{grid-template-columns:1fr 1fr}.hero-aside{display:none}}@media(max-width:650px){.hero{padding:45px 0;min-height:auto}.hero h1{font-size:49px}.metrics{grid-template-columns:1fr 1fr}.metrics>div{margin:0;padding:20px;border-bottom:1px solid #273441}.feature-grid{grid-template-columns:1fr}}</style>
