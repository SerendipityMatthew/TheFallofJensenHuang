---
import Base from '../layouts/Base.astro';import Timeline from '../components/Timeline';import {articles,events} from '../lib/data';
---
<Base title="Coverage timeline"><div class="page-heading"><span class="kicker">CHRONOLOGY / 01 OCT — 21 NOV 2026</span><h1>Coverage timeline</h1><p>Documented events and publication dates appear on separate animated tracks. Empty dates mean no verified records in this file.</p></div><Timeline articles={articles} events={events} client:only="react" /></Base>
<style>.event-note{padding:26px;margin-top:30px;border-left:2px solid #df6961}.event-note h2{font:600 22px 'Playfair Display',serif;margin:12px 0}.event-note p{color:#aab9c6;line-height:1.6;margin:0}.event-note a{color:#f18a83;text-decoration:underline}</style>
