---
import Base from '../layouts/Base.astro';
import { articles, publications } from '../lib/data';
const tones = ['Critical', 'Mixed', 'Neutral', 'Supportive'];
---
<Base title="Media comparison">
  <div class="page-heading"><span class="kicker">PUBLICATION LENS</span><h1>Media comparison</h1><p>Counts describe the source checked entries currently in this file. They are not a census of all coverage by each outlet.</p></div>
  <div class="section-head"><div><span class="kicker">OUTLET MATRIX</span><h2>Coverage by publication</h2></div><span class="meta">{publications.length} VERIFIED PUBLICATIONS</span></div>
  <div class="table-legend"><span><i class="critical"></i>Critical</span><span><i class="mixed"></i>Mixed</span><span><i class="neutral"></i>Neutral</span><span><i class="supportive"></i>Supportive</span></div>
  <div class="data-table-wrap panel" role="region" aria-label="Media comparison table" tabindex="0">
    <table class="data-table comparison-table"><thead><tr><th scope="col">Publication</th><th scope="col">Articles</th><th scope="col">Tone distribution</th><th scope="col">Journalists</th><th scope="col">Article types</th><th scope="col">Main topics</th></tr></thead><tbody>
      {publications.map(name => { const work = articles.filter(a => a.publication === name); return <tr><td class="publication-name">{name}</td><td><strong class="volume-number">{work.length}</strong></td><td><div class="distribution" role="img" aria-label={tones.map(t => `${t}: ${work.filter(a => a.sentiment === t).length}`).join(', ')}>{tones.map(t => { const count = work.filter(a => a.sentiment === t).length; return count ? <span class={t.toLowerCase()} style={`width:${count / work.length * 100}%`} title={`${t}: ${count}`}></span> : null; })}</div><small class="distribution-caption">{tones.filter(t => work.some(a => a.sentiment === t)).join(' · ')}</small></td><td><span class="count-chip">{new Set(work.flatMap(a => a.authors)).size}</span></td><td>{[...new Set(work.map(a => a.type))].map(t => <span class="table-type">{t}</span>)}</td><td>{[...new Set(work.map(a => a.topic))].join(' · ')}</td></tr>; })}
    </tbody></table>
  </div>
  <p class="muted table-footnote">Additional publications appear when an original article is checked and entered.</p>
</Base>
