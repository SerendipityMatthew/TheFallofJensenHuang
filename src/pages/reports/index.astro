---
import Base from '../../layouts/Base.astro';
import { reports } from '../../lib/reports';
---
<Base title="Research reports"><div class="page-heading"><span class="kicker">RESEARCH LIBRARY</span><h1>Research reports</h1><p>Event, media-comparison and periodic reports keep their source lists, status and last-reviewed date visible. Automatically assembled reports remain drafts.</p></div><div class="report-grid">{reports.map(report => <a class="panel report-card" href={`/reports/${report.id}/`}><div><span class="kicker">{report.type.toUpperCase()}</span><span class="badge mixed">{report.status}</span></div><h2>{report.title}</h2><p>{report.sections[0].body}</p><div class="meta">{report.sources.length} SOURCES · {report.lastReviewed ? `REVIEWED ${report.lastReviewed}` : 'AWAITING EDITOR REVIEW'}</div></a>)}</div></Base>
<style>.report-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:30px}.report-card{padding:26px;display:flex;flex-direction:column;min-height:250px}.report-card:hover{border-color:#e27871}.report-card>div:first-child{display:flex;justify-content:space-between}.report-card h2{font:600 25px/1.25 'Playfair Display',serif;margin:19px 0 12px}.report-card p{color:#9fafbc;font-size:13px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.report-card .meta{margin-top:auto}@media(max-width:700px){.report-grid{grid-template-columns:1fr}}</style>
