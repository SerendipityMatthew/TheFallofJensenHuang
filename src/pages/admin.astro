---
import Base from '../layouts/Base.astro';
---
<Base title="Research admin"><div class="page-heading"><span class="kicker">EDITORIAL WORKSPACE</span><h1>Research review</h1><p>Editor access is required. Submitted leads remain outside the public file until source metadata is checked and approved.</p></div><div class="admin-grid"><section class="panel admin-panel"><h2>Connect to review queue</h2><label>ADMIN TOKEN<input id="token" type="password" autocomplete="off" placeholder="Enter editor token"/></label><button id="load" class="btn primary">Load queue</button><p id="status" role="status" class="muted">Token stays in this page session.</p></section><section class="panel admin-panel"><h2>Add a research lead</h2><form id="lead"><label>ORIGINAL SOURCE URL<input name="source" type="url" required placeholder="https://publisher.example/story"/></label><label>HEADLINE<input name="headline" required placeholder="Headline as published"/></label><label>SOURCE KIND<select name="sourceKind"><option value="manual">Manual editorial</option><option value="rss">RSS</option><option value="news_api">News API</option><option value="publisher_metadata">Publisher metadata</option></select></label><button class="btn" type="submit">Add to queue</button></form></section></div><div class="section-head"><h2>Pending review</h2></div><div id="queue" class="panel empty"><strong>Queue not loaded</strong><p>Enter the editor token to inspect pending leads.</p></div><script is:inline>
const token=()=>document.getElementById('token').value;const status=document.getElementById('status');const queue=document.getElementById('queue');async function api(path,options={}){const response=await fetch('/api/'+path,{...options,headers:{'Content-Type':'application/json','Authorization':'Bearer '+token(),...(options.headers||{})}});const data=await response.json();if(!response.ok)throw Error(data.error||'Request failed');return data;}async function load(){try{const items=await api('submissions');status.textContent='Queue loaded';queue.className='queue';queue.replaceChildren();const pending=items.filter(x=>x.status==='Pending');if(!pending.length){queue.className='panel empty';queue.innerHTML='<strong>No pending leads</strong><p>New leads will appear here for review.</p>';return;}for(const row of pending){const payload=JSON.parse(row.payload);const card=document.createElement('section');card.className='panel queue-card';const title=document.createElement('h3');title.textContent=payload.headline;const source=document.createElement('a');source.href=payload.canonical_url;source.target='_blank';source.rel='noopener noreferrer';source.textContent=payload.canonical_url;const form=document.createElement('form');form.innerHTML='<div class="review-fields"><label>PUBLICATION<input name="publication" required></label><label>PUBLISHED DATE<input type="date" name="published_at" required></label><label>AUTHORS (COMMA SEPARATED)<input name="authors" required></label><label>ARTICLE TYPE<select name="article_type"><option>News</option><option>Investigation</option><option>Opinion</option><option>Satire</option><option>Analysis</option><option>Podcast</option></select></label><label>TONE<select name="sentiment"><option>Neutral</option><option>Critical</option><option>Mixed</option><option>Supportive</option></select></label><label>TOPIC<input name="topic" required></label><label>EVIDENCE LEVEL<select name="evidence_level"><option>Attributed</option><option>Documented</option><option>Disputed</option><option>Unverified</option></select></label><label>SOURCE CHECK DATE<input type="date" name="source_checked_at" required></label><label class="wide">ORIGINAL SUMMARY<textarea name="summary" required></textarea></label><label class="wide">CLASSIFICATION REASON<textarea name="classification_reason" required></textarea></label><label class="wide">REVIEW NOTE<textarea name="reason" required></textarea></label></div><div class="review-actions"><button class="btn primary" type="submit">Verify & publish</button><button class="btn reject" type="button">Reject lead</button></div>';form.addEventListener('submit',async e=>{e.preventDefault();const values=Object.fromEntries(new FormData(form));values.authors=values.authors.split(',').map(x=>x.trim()).filter(Boolean);values.decision='approve';values.metadata_status='Verified';try{await api('submissions/'+row.id+'/review',{method:'POST',body:JSON.stringify(values)});status.textContent='Article approved. Public explorer and timeline are updated. Rebuild for profile and detail pages.';load()}catch(err){status.textContent=err.message}});form.querySelector('.reject').addEventListener('click',async()=>{const reason=prompt('Why reject this lead?');if(reason===null)return;try{await api('submissions/'+row.id+'/review',{method:'POST',body:JSON.stringify({decision:'reject',reason})});load()}catch(err){status.textContent=err.message}});card.append(title,source,form);queue.append(card)}}catch(err){status.textContent=err.message}}document.getElementById('load').addEventListener('click',load);document.getElementById('lead').addEventListener('submit',async e=>{e.preventDefault();try{await api('submissions',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});e.target.reset();load()}catch(err){status.textContent=err.message}});
</script></Base>
<style>.admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:30px}.admin-panel,.queue-card{padding:25px}.admin-panel h2,.queue-card h3{font:600 23px 'Playfair Display',serif}.admin-panel form{display:grid;gap:12px}.admin-panel label,.queue-card label{display:grid;gap:7px;font:11px 'IBM Plex Mono',monospace;color:#9daebd;letter-spacing:.06em;margin-bottom:13px}input,select,textarea{width:100%;background:#0c141d;color:#edf2f6;border:1px solid #40505d;border-radius:4px;padding:11px;min-height:43px}textarea{min-height:80px;resize:vertical}.admin-panel button{margin-top:8px}.admin-panel p{font-size:12px;margin-top:15px}.queue{display:grid;gap:15px}.queue-card>a{font-size:12px;color:#ef837b;overflow-wrap:anywhere}.review-fields{display:grid;grid-template-columns:repeat(2,1fr);gap:4px 14px;margin-top:22px}.wide{grid-column:1/-1}.review-actions{display:flex;gap:10px}@media(max-width:700px){.admin-grid,.review-fields{grid-template-columns:1fr}.wide{grid-column:auto}}</style>
